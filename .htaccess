# Security Headers
<IfModule mod_headers.c>
    # Content Security Policy
    # This policy allows resources from current domain, Google Analytics, Meta Pixel, and common CDNs.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com https://googleads.g.doubleclick.net https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.facebook.com; frame-src 'self';"

    # Protect against Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Strict Transport Security (HSTS) - uncomment if SSL is fully set up
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HTML siempre revalidado: evita servir paginas viejas tras un deploy
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# Caching for performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    # El HTML NO se cachea (cada actualizacion del sitio se ve al instante)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresDefault "access plus 2 days"
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# PL EXPRÉS DENTRO DE ESTE DOMINIO (2026-09-07)
# La app corre en Render, pero se sirve bajo ahwealthgroup.com para que el
# cliente nunca vea otro dominio al subir sus estados de cuenta.
#   · CNAME a Render → imposible: el DNS lo controla un tercero.
#   · mod_proxy [P]  → imposible: está cargado, pero Hostinger bloquea sus
#                      conexiones salientes (503 medido).
#   · PHP + cURL     → SÍ (PHP 8.3.33, 126 ms al servicio). Es lo que se usa.
# Estas 4 rutas están LIBRES en el sitio (verificado): no pisan ninguna página.
# proxy.php tiene el destino FIJO escrito dentro; nunca sale de la URL.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enlaces viejos: /clientes/?t=TOKEN  ->  /c/TOKEN  (301 del servidor).
    # La pagina puente que hacia este salto con JavaScript ya no existe; esto
    # es solo para que los enlaces repartidos antes del 7-sep-2026 no mueran.
    # Se puede quitar cuando no quede ninguno en circulacion.
    RewriteCond %{QUERY_STRING} ^t=([A-Za-z0-9_-]{16,64})$
    RewriteRule ^clientes/?$       /c/%1?     [R=301,L]

    RewriteRule ^(c|prep)(/.*)?$   proxy.php  [QSA,L]
    RewriteRule ^healthz$          proxy.php  [QSA,L]
    RewriteRule ^styles\.css$      proxy.php  [QSA,L]
</IfModule>
# ─────────────────────────────────────────────────────────────────────────────

# 9-sep-2026: .user.ini (ajustes de PHP para proxy.php) no debe servirse por HTTP.
# Apache ya protege .htaccess; este archivo no, y respondia 200.
<Files ".user.ini">
    Require all denied
</Files>
